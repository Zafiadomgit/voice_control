ANTHROPIC_API_KEY=sk-ant-...

# Opcional — ruta a tu vault de Obsidian donde Alfred guarda su memoria.
# Corre `python setup_obsidian.py` para crear la estructura ahí la primera vez.
OBSIDIAN_VAULT_PATH=C:\Users\david\Documents\Vault

# Opcional — servidor web para hablarle a Alfred desde el teléfono.
# Ver ALFRED_TELEFONO.md para la configuración completa con Tailscale.
WEB_SERVER_ENABLED=false
WEB_SERVER_PORT=8420
WEB_ACCESS_TOKEN=cambia-esto-por-algo-secreto
